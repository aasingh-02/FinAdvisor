# ───────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────
# Format: postgresql+asyncpg://username:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/finadvisor_db
# Optional SQLAlchemy SQL statement echo for local development debugging (FIN-SEC-05).
# Defaults to false. Production ALWAYS forces SQL echo to false even if DATABASE_ECHO=true.
# Bound SQL parameter values are always hidden (hide_parameters=true).
DATABASE_ECHO=false

# ───────────────────────────────────────────────
# Session
# ───────────────────────────────────────────────
# Session expiration in hours (sessions are cryptographically generated and DB-backed)
SESSION_EXPIRE_HOURS=24
# Expired session pruning interval in seconds (default: 3600 = 1 hour)
SESSION_CLEANUP_INTERVAL_SECONDS=3600
SESSION_CLEANUP_ENABLED=true
# Optional explicit Secure flag for session cookies (FIN-SEC-03).
# Leave unset/blank to use environment defaults: true in production, false otherwise.
# Set COOKIE_SECURE=true in HTTPS staging environments without setting ENVIRONMENT=production.
# Production always enforces Secure=True (COOKIE_SECURE=false is disallowed in production).
COOKIE_SECURE=
# Session cookie SameSite attribute: lax, strict, or none (default: lax).
# Set to 'none' for cross-origin split deployments (e.g. Vercel frontend + cloud backend host).
# Modern browsers require COOKIE_SECURE=true when COOKIE_SAMESITE=none.
COOKIE_SAMESITE=lax

# ───────────────────────────────────────────────
# Google Gemini  (Phase 5 — leave blank for now)
# ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ───────────────────────────────────────────────
# App
# ───────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ───────────────────────────────────────────────
# Redis / Distributed Rate Limiting (FIN-SEC-01)
# ───────────────────────────────────────────────
# Format: redis://[[username]:[password]]@host:port/db
# Required in production to ensure rate limits are shared across multiple Uvicorn workers.
REDIS_URL=redis://localhost:6379/0

# Explicit development-only opt-in allowing process-local in-memory rate limiting when Redis is absent.
# Set to 'true' only for local development/testing without Redis.
# Strictly disallowed in production (cannot bypass Redis requirement in production).
ALLOW_IN_MEMORY_RATE_LIMIT=false

# ───────────────────────────────────────────────
# Trusted Reverse Proxies (FIN-SEC-04)
# ───────────────────────────────────────────────
# Comma-separated list of trusted proxy IPs and/or CIDR ranges allowed to supply X-Forwarded-For.
# Supports individual IPv4/IPv6 addresses and IPv4/IPv6 CIDR ranges.
# Only requests whose immediate TCP peer matches this list will trust X-Forwarded-For
# (evaluated right-to-left to ignore client-spoofed left-hand header entries).
#
# Deployment examples:
# - Direct deployment without a proxy (recommended default):
#   Leave blank so X-Forwarded-For is never trusted and direct peer IPs are used:
#   TRUSTED_PROXY_IPS=
#
# - Nginx running on the same host (localhost proxy):
#   TRUSTED_PROXY_IPS=127.0.0.1,::1
#
# - Nginx or AWS ALB in a private VPC subnet (IPv4 & IPv6 CIDR examples):
#   TRUSTED_PROXY_IPS=10.0.0.0/16,172.16.0.0/12
#   TRUSTED_PROXY_IPS=10.20.0.0/16,2001:db8:1::/48,::1
#
# SECURITY WARNING:
# - NEVER configure 0.0.0.0/0, ::/0, or * (wildcard proxy trust is forbidden).
#   Trusting all networks allows arbitrary clients to spoof X-Forwarded-For and bypass rate limits.
# - Do NOT run Uvicorn with --proxy-headers --forwarded-allow-ips="*".
TRUSTED_PROXY_IPS=

# Production Nginx configuration template for FinAdvisor React SPA (FIN-SEC-02).
#
# Setting Content-Security-Policy on FastAPI JSON responses does NOT govern a
# separately hosted React SPA. Configure these HTTP response headers on the
# frontend web server / CDN serving `frontend/dist/index.html`.
#
# Replace `${API_ORIGIN}` with your exact backend API origin when using a
# cross-origin deployment (e.g. `https://api.finadvisor.example.com`), OR omit
# `${API_ORIGIN}` (leaving `connect-src 'self';`) for same-origin reverse-proxy deployments.

server {
    listen 443 ssl http2;
    server_name app.finadvisor.example.com;

    root /usr/share/nginx/html;
    index index.html;

    # Security Headers (matching backend/app/middleware/security_headers.py & frontend/csp.js)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Cross-origin API example:
    #   connect-src 'self' https://api.finadvisor.example.com;
    # Same-origin proxy example (with `/api` proxied below):
    #   connect-src 'self';
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;

    # React Router SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Optional same-origin API reverse proxy (set VITE_API_BASE_URL=/api at build time
    # and remove ${API_ORIGIN} from connect-src above so connect-src stays 'self'):
    # location /api/ {
    #     proxy_pass http://127.0.0.1:8000;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}

# Backend API Base URL:
# - Local cross-origin dev: http://localhost:8000
# - Cross-origin production: https://api.finadvisor.example.com
# - Same-origin reverse-proxy production: /api (or matching frontend origin)
# Note: frontend/vite.config.js derives CSP `connect-src` from this exact value.
VITE_API_BASE_URL=http://localhost:8000

# Optional explicit public origin serving the React SPA (used for dev HMR WS & same-origin detection)
# VITE_FRONTEND_ORIGIN=http://localhost:5173
